{
  "name": "oscd-remove-ieds",
  "description": "OpenSCD Menu Plugin for removing IEDs from SCL files.",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/danyill/oscd-remove-ieds.git"
  },
  "bugs": {
    "url": "https://github.com/danyill/oscd-remove-ieds/issues"
  },
  "homepage": "https://openscd.org",
  "keywords": [
    "OpenSCD",
    "iec61850",
    "GOOSE",
    "SMV",
    "SampledValues",
    "subscriber",
    "data-binding"
  ],
  "author": "Daniel Mulholland",
  "main": "dist/oscd-remove-ieds.js",
  "license": "Apache-2.0",
  "module": "dist/oscd-remove-ieds.js",
  "exports": {
    ".": "./dist/oscd-remove-ieds.js"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "analyze": "cem analyze --litelement --exclude demo/* --exclude dist/* --exclude *.spec.ts --exclude *.test.ts --exclude coverage/*",
    "start": "rimraf dist && tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds --watch --node-resolve\"",
    "start:bundle": "npm run bundle && concurrently -k -r \"rollup -c rollup.config.js --watch\" \"wds --watch --root-dir ./dist\"",
    "build": "rimraf dist && mkdir dist && tsc ",
    "bundle": "rimraf dist && rollup -c rollup.config.js",
    "doc": "npm run analyze -- --exclude dist && typedoc ./*.ts --out dist/doc",
    "test": "npm run build && wtr --coverage --group unit",
    "test:watch": "npm run build && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wtr  --coverage --watch --group unit\"",
    "test:visual": "npm run build && wtr --group visual",
    "test:update": "npm run build && wtr --group visual --update-visual-baseline",
    "deploy": "npm run bundle && gh-pages -d dist -b deploy",
    "preinstall": "git submodule update --init --recursive --remote",
    "prepare": "husky"
  },
  "dependencies": {
    "@omicronenergy/oscd-menu-open": "^0.0.6",
    "@omicronenergy/oscd-menu-save": "^0.0.2",
    "@omicronenergy/oscd-shell": "^0.0.13",
    "@omicronenergy/oscd-ui": "^0.0.12",
    "@open-wc/scoped-elements": "^3.0.6",
    "@openscd/oscd-api": "^0.1.6",
    "@openscd/scl-lib": "^2.0.0",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^9.34.0",
    "@omicronenergy/oscd-background-editv1": "^0.0.7",
    "@omicronenergy/oscd-menu-open": "^0.0.6",
    "@omicronenergy/oscd-menu-save": "^0.0.2",
    "@open-wc/dev-server-hmr": "^0.2.0",
    "@open-wc/testing": "^4.0.0",
    "@openscd/oscd-editor": "^1.8.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-polyfill": "^1.0.6",
    "@web/rollup-plugin-html": "^3.1.0",
    "@web/rollup-plugin-import-meta-assets": "^2.3.3",
    "@web/test-runner": "0.20.2",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "0.11.1",
    "@web/test-runner-visual-regression": "0.10.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.2.1",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-tsdoc": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.1",
    "rollup-plugin-copy": "^3.5.0",
    "sinon": "^21.1.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.2"
  },
  "customElements": "custom-elements.json",
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "@open-wc",
      "prettier"
    ],
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "import/no-unresolved": "off",
      "import/extensions": [
        "error",
        "always",
        {
          "ignorePackages": true
        }
      ],
      "import/no-extraneous-dependencies": [
        "error",
        {
          "devDependencies": [
            "**/*.spec.ts"
          ]
        }
      ],
      "lit/no-classfield-shadowing": "off",
      "no-duplicate-imports": "off",
      "no-unused-vars": "off",
      "no-redeclare": "off",
      "no-unused-expressions": "off"
    },
    "overrides": [
      {
        "files": [
          "**/*.spec.ts"
        ],
        "rules": {
          "import/no-extraneous-dependencies": "off"
        }
      }
    ]
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
